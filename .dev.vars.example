# Copy to .dev.vars for local `wrangler pages dev`. NEVER commit .dev.vars.
# These are read as env bindings by the Pages Functions at runtime.

# Required for the /api/ai proxy. The key lives here (server-side) only —
# it is never sent to or exposed in the browser.
OPENROUTER_API_KEY=sk-or-...

# Optional. If set, every /api/* request must send `Authorization: Bearer <APP_TOKEN>`.
# Leave unset for open local dev.
APP_TOKEN=

# Optional. Overrides the default model pinned in wrangler.toml.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
